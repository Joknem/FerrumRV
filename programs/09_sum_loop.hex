# 09_sum_loop: 填充三角数数组、反向读取校验、嵌套循环和斐波那契
# 入口 0x80000000；RAM 4096 字节；数据区 0x80000800。
0x80000000: 0x80001a37    # lui x20, 0x80001
0x80000004: 0x800a0a13    # addi x20, x20, -2048

# 写入 1..16 的前缀和：最后一项 136，全部项之和 816
0x80000008: 0x00100093    # addi x1, x0, 1
0x8000000c: 0x01100113    # addi x2, x0, 17
0x80000010: 0x00000193    # addi x3, x0, 0
0x80000014: 0x000a0a93    # addi x21, x20, 0
# prefix:
0x80000018: 0x001181b3    # add x3, x3, x1
0x8000001c: 0x003aa023    # sw x3, 0(x21)
0x80000020: 0x004a8a93    # addi x21, x21, 4
0x80000024: 0x00108093    # addi x1, x1, 1
0x80000028: 0xfe20c8e3    # blt x1, x2, -16 ; prefix @ 0x80000018
0x8000002c: 0x08800e13    # addi x28, x0, 136
0x80000030: 0x09c19063    # bne x3, x28, +128 ; fail @ 0x800000b0
0x80000034: 0x01000093    # addi x1, x0, 16
0x80000038: 0x00000213    # addi x4, x0, 0
# reverse:
0x8000003c: 0xffcaa283    # lw x5, -4(x21)
0x80000040: 0x00520233    # add x4, x4, x5
0x80000044: 0xffca8a93    # addi x21, x21, -4
0x80000048: 0xfff08093    # addi x1, x1, -1
0x8000004c: 0xfe0098e3    # bne x1, x0, -16 ; reverse @ 0x8000003c
0x80000050: 0x33000e13    # addi x28, x0, 816
0x80000054: 0x05c21e63    # bne x4, x28, +92 ; fail @ 0x800000b0

# 嵌套循环：3 × 4 次累加
0x80000058: 0x00300093    # addi x1, x0, 3
0x8000005c: 0x00000213    # addi x4, x0, 0
# outer:
0x80000060: 0x00400113    # addi x2, x0, 4
# inner:
0x80000064: 0x00120213    # addi x4, x4, 1
0x80000068: 0xfff10113    # addi x2, x2, -1
0x8000006c: 0xfe011ce3    # bne x2, x0, -8 ; inner @ 0x80000064
0x80000070: 0xfff08093    # addi x1, x1, -1
0x80000074: 0xfe0096e3    # bne x1, x0, -20 ; outer @ 0x80000060
0x80000078: 0x00c00e13    # addi x28, x0, 12
0x8000007c: 0x03c21a63    # bne x4, x28, +52 ; fail @ 0x800000b0

# 迭代十次 Fibonacci，F10=55
0x80000080: 0x00000093    # addi x1, x0, 0
0x80000084: 0x00100113    # addi x2, x0, 1
0x80000088: 0x00a00193    # addi x3, x0, 10
# fib:
0x8000008c: 0x00208233    # add x4, x1, x2
0x80000090: 0x00010093    # addi x1, x2, 0
0x80000094: 0x00020113    # addi x2, x4, 0
0x80000098: 0xfff18193    # addi x3, x3, -1
0x8000009c: 0xfe0198e3    # bne x3, x0, -16 ; fib @ 0x8000008c
0x800000a0: 0x03700e13    # addi x28, x0, 55
0x800000a4: 0x01c09663    # bne x1, x28, +12 ; fail @ 0x800000b0

# 全部检查通过：a0=0；任一检查失败跳转到 fail，a0=1。
0x800000a8: 0x00000513    # addi x10, x0, 0
0x800000ac: 0x00100073    # ebreak
# fail:
0x800000b0: 0x00100513    # addi x10, x0, 1
0x800000b4: 0x00100073    # ebreak
