# 全部检查通过：a0=0；任一检查失败跳转到 fail，a0=1。
0x80000118: 0x00000513    # addi x10, x0, 0
0x8000011c: 0x00100073    # ebreak
# fail:
0x80000120: 0x00100513    # addi x10, x0, 1
