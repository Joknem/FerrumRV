# 02_immediate_logic: 立即数符号扩展与连续掩码处理
# 入口 0x80000000；RAM 4096 字节；数据区 0x80000800。

# 输入 0x12345678
0x80000000: 0x123450b7    # lui x1, 0x12345
0x80000004: 0x67808093    # addi x1, x1, 1656
0x80000008: 0x0ff0f193    # andi x3, x1, 255
0x8000000c: 0x07800e13    # addi x28, x0, 120
0x80000010: 0x11c19863    # bne x3, x28, +272 ; fail @ 0x80000120
0x80000014: 0xf000f193    # andi x3, x1, -256
0x80000018: 0x12345e37    # lui x28, 0x12345
0x8000001c: 0x600e0e13    # addi x28, x28, 1536
0x80000020: 0x11c19063    # bne x3, x28, +256 ; fail @ 0x80000120
0x80000024: 0x8000e193    # ori x3, x1, -2048
0x80000028: 0xe7800e13    # addi x28, x0, -392
0x8000002c: 0x0fc19a63    # bne x3, x28, +244 ; fail @ 0x80000120
0x80000030: 0xfff0c193    # xori x3, x1, -1
0x80000034: 0xedcbbe37    # lui x28, 0xedcbb
0x80000038: 0x987e0e13    # addi x28, x28, -1657
0x8000003c: 0x0fc19263    # bne x3, x28, +228 ; fail @ 0x80000120
0x80000040: 0x1550e193    # ori x3, x1, 341
0x80000044: 0x12345e37    # lui x28, 0x12345
0x80000048: 0x77de0e13    # addi x28, x28, 1917
0x8000004c: 0x0dc19a63    # bne x3, x28, +212 ; fail @ 0x80000120

# 输入 0x80000000
0x80000050: 0x800000b7    # lui x1, 0x80000
0x80000054: 0x0ff0f193    # andi x3, x1, 255
